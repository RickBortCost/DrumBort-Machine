<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- WinExe: su Windows nessuna console all'avvio (finestra di programma); da terminale si collega alla sua -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DrumBortHost</AssemblyName>
    <RootNamespace>DrumBort</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Version>1.16.0</Version>
    <Product>DrumBort Host</Product>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <!-- Web app servita ai dispositivi (copiata dalla radice del repository) -->
  <ItemGroup>
    <None Include="../index.html;../manifest.webmanifest" Link="wwwroot/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../css/**/*" Link="wwwroot/css/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../js/**/*" Link="wwwroot/js/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../icons/**/*" Link="wwwroot/icons/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
